# MODULE.bazel
module(name = "three_languages_one_workspace")

# Must precede rules_cc: registers the Xcode-aware C++ toolchain on macOS, which
# knows about SDK files (e.g. SDKSettings.json) that newer Apple clang reports.
bazel_dep(name = "apple_support", version = "2.10.0", repo_name = "build_bazel_apple_support")
bazel_dep(name = "rules_cc", version = "0.2.22")
bazel_dep(name = "rules_java", version = "9.9.0")
bazel_dep(name = "rules_go", version = "0.64.2")        # Go rules
bazel_dep(name = "gazelle", version = "0.54.0")         # the BUILD-file generator
bazel_dep(name = "rules_jvm_external", version = "6.9") # Maven artifacts (JUnit for java_test)

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    artifacts = ["junit:junit:4.13.2"],
    repositories = ["https://repo1.maven.org/maven2"],
)
use_repo(maven, "maven")
